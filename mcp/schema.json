{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "name": "spidercaster-mcp",
  "version": "0.1.0",
  "description": "Formal MCP tool interface of the working SpiderCaster engine. Normative live source: mcp_server.py TOOLS/TOOL_SPECS (stdio JSON-RPC 2.0). This file is generated from it; schema tools[] must equal server TOOLS exactly.",
  "live_interface": "mcp_server.py",
  "transport": "MCP stdio (newline-delimited JSON-RPC 2.0 on stdin/stdout; logs to stderr only)",
  "tools": [
    {
      "name": "catalog_read",
      "description": "SpiderCaster section catalog: types, data fields, icons, templates, content rules.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "tokens_read",
      "description": "Resolved theme tokens (CSS vars) for template/dark/accent. Agents set knobs, never literals.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "template": {
            "type": "string",
            "enum": [
              "modern",
              "editorial",
              "bold"
            ]
          },
          "dark": {
            "type": "boolean"
          },
          "accent": {
            "type": "string"
          },
          "accent2": {
            "type": "string"
          },
          "seed": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "pagemodel_read",
      "description": "Read a built site's IR (site.json).",
      "inputSchema": {
        "type": "object",
        "required": [
          "site"
        ],
        "properties": {
          "site": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "pagemodel_write",
      "description": "Write the IR. role=builder: mode=full. role=content|editor: mode=patch, same-type sections only, no new pages.",
      "inputSchema": {
        "type": "object",
        "required": [
          "site",
          "pageModel"
        ],
        "properties": {
          "site": {
            "type": "string"
          },
          "pageModel": {
            "type": "object"
          },
          "mode": {
            "type": "string",
            "enum": [
              "full",
              "patch"
            ]
          },
          "role": {
            "type": "string",
            "enum": [
              "builder",
              "content",
              "editor"
            ]
          }
        }
      }
    },
    {
      "name": "render_trigger",
      "description": "Deterministic render of the IR to static HTML. Zero tokens.",
      "inputSchema": {
        "type": "object",
        "required": [
          "site"
        ],
        "properties": {
          "site": {
            "type": "string"
          },
          "noindex": {
            "type": "boolean"
          }
        }
      }
    },
    {
      "name": "validate_run",
      "description": "Fleet-aligned checks: no_sample, hotlinks, links, meta, noindex, ledger.",
      "inputSchema": {
        "type": "object",
        "required": [
          "site"
        ],
        "properties": {
          "site": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "review_write",
      "description": "Reviewer writes LLM judgment + revision requests to review/ on the site.",
      "inputSchema": {
        "type": "object",
        "required": [
          "site",
          "results"
        ],
        "properties": {
          "site": {
            "type": "string"
          },
          "pagePath": {
            "type": "string"
          },
          "results": {
            "type": "object"
          }
        }
      }
    },
    {
      "name": "brand_read",
      "description": "Read brand inputs: project brief + copy files, and/or built site meta/theme.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "project": {
            "type": "string"
          },
          "site": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "brand_write",
      "description": "Patch brand knobs on a built site: title, description, template, dark, accent.",
      "inputSchema": {
        "type": "object",
        "required": [
          "site",
          "brand"
        ],
        "properties": {
          "site": {
            "type": "string"
          },
          "brand": {
            "type": "object"
          }
        }
      }
    },
    {
      "name": "draft_offline",
      "description": "Zero-token deterministic draft of a site IR from a project's real copy.",
      "inputSchema": {
        "type": "object",
        "required": [
          "project"
        ],
        "properties": {
          "project": {
            "type": "string"
          },
          "template": {
            "type": "string",
            "enum": [
              "modern",
              "editorial",
              "bold"
            ]
          },
          "dark": {
            "type": "boolean"
          },
          "brand": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "wallets",
      "description": "Fingerprint map of recorded Google wallets (last4 + fp only). FIFO planning.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "secretsDir": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "crew_roles",
      "description": "The seven SpiderCaster seats, the hands each may call, and what each refuses.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "mold_list",
      "description": "Package molds only. Vendor frames are not listed.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "frame_list",
      "description": "Package section frames. Not molds, not vendor themes, no photos.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "frame_pick",
      "description": "Load one package section frame by id. No vault, photos, or HTML.",
      "inputSchema": {
        "type": "object",
        "required": [
          "frame_id"
        ],
        "properties": {
          "frame_id": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "env_doctor",
      "description": "Read-only environment report. Does not publish and does not read secrets.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "seat_pack",
      "description": "Read-only pack for one seat. Does not publish and does not read secrets.",
      "inputSchema": {
        "type": "object",
        "required": [
          "seat_id"
        ],
        "properties": {
          "seat_id": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "skill_read",
      "description": "Read one SKILL.md. root defaults to the package root. Does not publish and does not read secrets.",
      "inputSchema": {
        "type": "object",
        "required": [
          "rel"
        ],
        "properties": {
          "root": {
            "type": "string"
          },
          "rel": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "hook_match",
      "description": "Match hook rows in memory. Never runs a command. Does not publish and does not read secrets.",
      "inputSchema": {
        "type": "object",
        "required": [
          "event",
          "tool_name",
          "hooks"
        ],
        "properties": {
          "event": {
            "type": "string"
          },
          "tool_name": {
            "type": "string"
          },
          "hooks": {
            "type": "object"
          }
        }
      }
    },
    {
      "name": "perm_rule",
      "description": "Decide allow, deny, or ask from rule lists. Does not publish and does not read secrets.",
      "inputSchema": {
        "type": "object",
        "required": [
          "tool",
          "arg",
          "allow",
          "deny"
        ],
        "properties": {
          "tool": {
            "type": "string"
          },
          "arg": {
            "type": "string"
          },
          "allow": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "deny": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    {
      "name": "tool_search_local",
      "description": "Search an in-memory tool catalog. Does not publish and does not read secrets.",
      "inputSchema": {
        "type": "object",
        "required": [
          "query",
          "catalog"
        ],
        "properties": {
          "query": {
            "type": "string"
          },
          "catalog": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    {
      "name": "seat_tools",
      "description": "Filter a seat tool list offline. Does not publish and does not read secrets.",
      "inputSchema": {
        "type": "object",
        "required": [
          "parent"
        ],
        "properties": {
          "parent": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tools": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          },
          "disallowed": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    {
      "name": "seat_gate",
      "description": "Allow a hand only when the caller is that seat. Does not publish and does not read secrets.",
      "inputSchema": {
        "type": "object",
        "required": [
          "caller",
          "seat",
          "hand"
        ],
        "properties": {
          "caller": {
            "type": "string"
          },
          "seat": {
            "type": "string"
          },
          "hand": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "layer_read",
      "description": "Read the first page layer list. Does not publish and does not read secrets.",
      "inputSchema": {
        "type": "object",
        "required": [
          "out",
          "root"
        ],
        "properties": {
          "out": {
            "type": "string"
          },
          "root": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "code_refuse",
      "description": "Refuse a code-file kind. Does not publish and does not read secrets.",
      "inputSchema": {
        "type": "object",
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "mold_panel",
      "description": "Read one package mold's tokens. Does not publish and does not read secrets.",
      "inputSchema": {
        "type": "object",
        "required": [
          "mold_id"
        ],
        "properties": {
          "mold_id": {
            "type": "string"
          }
        }
      }
    }
  ]
}
